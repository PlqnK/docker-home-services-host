[Unit]
Description=Immich Redis
Documentation=man:podman-systemd.unit(5)

[Container]
ContainerName=immich-redis
Image={{ containers_images.immich.redis }}:{{ containers_images_tags.immich.redis }}
Exec=redis-server /usr/local/etc/redis/redis.conf
Network=immich-redis-internal
ExposeHostPort=6379
Volume={{ containers_storage_path }}/config/immich-redis/redis.conf:/usr/local/etc/redis/redis.conf:Z,ro
Volume={{ containers_storage_path }}/runtime/immich-redis:/data:Z
Timezone={{ timezone }}
Environment="TZ={{ timezone }}"
HealthCmd="redis-cli ping"
HealthInterval=10s
HealthTimeout=3s
HealthRetries=3
Notify=healthy
AutoUpdate=local

[Service]
Restart=on-failure
TimeoutStartSec=300
TimeoutStopSec=70

[Install]
WantedBy=default.target
